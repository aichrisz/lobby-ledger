{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "jsxImportSource": "preact",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "types": ["vite/client", "node"], "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "api", "e2e", "supabase/tests", "vite.config.ts", "vite.pilot.config.ts",
    "playwright.config.ts", "playwright.pilot.config.ts", "vitest.db.config.ts", "scripts"]
}
